<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Arizona Public Service (APS) – Agent Call Script</title>
</head>
<body>

    <h1>Arizona Public Service (APS)</h1>
    <h2>Agent Voice Call Script</h2>

    <form>

        <fieldset>
            <legend>Customer Information</legend>

            <label for="firstName">First Name:</label><br>
            <input type="text" id="firstName" name="firstName"><br><br>

            <label for="lastName">Last Name:</label><br>
            <input type="text" id="lastName" name="lastName"><br><br>

            <label for="phoneNumber">Phone Number:</label><br>
            <input type="tel" id="phoneNumber" name="phoneNumber"><br><br>

            <label for="address">Address:</label><br>
            <input type="text" id="address" name="address"><br><br>

            <label for="startServiceDate">Start of Service Date:</label><br>
            <input type="date" id="startServiceDate" name="startServiceDate"><br><br>

        </fieldset>

        <br>

        <fieldset>
            <legend>Account Details</legend>

            <label for="accountNumber">Account Number:</label><br>
            <input type="text" id="accountNumber" name="accountNumber"><br><br>

            <label for="accountBalance">Account Balance:</label><br>
            <input type="text" id="accountBalance" name="accountBalance"><br><br>

            <label for="planRateDetails">Plan Rate Details:</label><br>
            <textarea id="planRateDetails" name="planRateDetails" rows="4" cols="50"></textarea><br><br>

        </fieldset>

        <br>

        <fieldset>
            <legend>Verification & Call Context</legend>

            <label for="identityVerified">Identity Verification Status:</label><br>
            <input type="checkbox" id="identityVerified" name="identityVerified" value="true">
            <label for="identityVerified">Verified (True)</label><br><br>

            <label for="callerIntent">Caller Intent:</label><br>
            <textarea id="callerIntent" name="callerIntent" rows="4" cols="50"></textarea><br><br>

        </fieldset>

    </form>

</body>
</html>
